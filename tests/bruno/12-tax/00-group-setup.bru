meta {
  name: 12-tax group setup
  type: http
  seq: 0
  tags: [
    tax
  ]
}

get {
  url: {{baseUrl}}/v1/config/catalog?types=countries
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8));
  }
  bru.setVar("correlationId", "12-tax:" + bru.getVar("runId"));
}

docs {
  Group Tax: prepare runId before the operations in this folder.
}
