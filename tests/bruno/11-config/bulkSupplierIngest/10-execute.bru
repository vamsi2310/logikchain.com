meta {
  name: validateSupplierBulkImport
  type: http
  seq: 10
  tags: [
    config
    bulkSupplierIngest
  ]
}

post {
  url: {{baseUrl}}/v1/config/suppliers/sup_ongole_01/bulk-import/validate
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Correlation-Id: bulk-validate-01
}

body:json {
  {
    "selectedCategories": ["drivers", "trucks"],
    "datasets": {
      "drivers": [
        { "driverName": "Ramesh Kumar", "phone": "+919848022001", "licenseNumber": "DL-AP-2024-1001" }
      ],
      "trucks": [
        { "regPlate": "AP27TZ1001", "payloadKg": 3500, "fuelType": "Diesel" }
      ]
    }
  }
}

assert {
  res.status: in [200, 400, 401, 403, 404, 409, 429]
}

tests {
  test("status is a spec HTTP code", function () {
    expect([200, 400, 401, 403, 404, 409, 429]).to.include(res.getStatus());
  });
  test("envelope is spec-shaped", function () {
    const status = res.getStatus();
    const body = res.getBody();
    if (status === 200) {
      expect(body).to.be.an("object");
      expect(body).to.have.property("success");
      expect(body).to.have.property("status");
    }
  });
}

docs {
  operationId: validateSupplierBulkImport
  HTTP: POST /v1/config/suppliers/{supplierId}/bulk-import/validate
  Role: support
}
