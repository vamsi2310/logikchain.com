meta {
  name: upsertSubscriptionPlan
  type: http
  seq: 10
  tags: [
    config
    upsertSubscriptionPlan
  ]
}

put {
  url: {{baseUrl}}/v1/config/plans/{{planId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{correlationId}}
}

body:json {
  {
    "id": "plan_bruno_{{runId}}",
    "name": "Bruno Plan",
    "targetRole": "supplier",
    "status": "draft",
    "features": [
      "bruno"
    ],
    "entitlements": [
      "finance.dashboard"
    ]
  }
}

assert {
  res.status: in [200, 400, 401, 403, 404, 409, 429]
}

script:pre-request {
  const operationId = "upsertSubscriptionPlan";
  const role = "support";
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8));
  }
  bru.setVar("idempotencyKey", "idem-" + operationId + "-" + bru.getVar("runId"));
  bru.setVar("correlationId", operationId + ":" + bru.getVar("runId"));
  if (!bru.getVar("supplierPhone")) {
    const randomDigits = Math.floor(100000000 + Math.random() * 900000000).toString();
    bru.setVar("supplierPhone", "+919" + randomDigits);
  }
  const authEmulator = bru.getEnvVar("authEmulator");
  const email = bru.getEnvVar("seedSupportEmail") || bru.getEnvVar("seedSupportEmail") || "vamsi2310@gmail.com";
  const password = bru.getEnvVar("seedPassword") || "TestPassword123!";
  const tokenVar = "supportAccessToken";
  if (tokenVar && !bru.getVar(tokenVar)) {
    const existingToken = bru.getVar(tokenVar) || bru.getEnvVar(tokenVar) || bru.getVar("supportAccessToken") || bru.getEnvVar("supportAccessToken") || bru.getVar("accessToken") || bru.getEnvVar("accessToken");
    if (existingToken) {
      bru.setVar(tokenVar, existingToken);
    } else if (email && password) {
      try {
        const key = bru.getEnvVar("firebaseWebApiKey") || "fake-api-key";
        const authUrl = authEmulator
          ? authEmulator + "/identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key
          : "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key;
        let data;
        if (typeof bru.sendRequest === "function") {
          const resp = await bru.sendRequest({
            url: authUrl,
            method: "POST",
            headers: { "Content-Type": "application/json" },
            data: { email, password, returnSecureToken: true }
          });
          data = resp ? resp.data : null;
        } else if (typeof fetch === "function") {
          const resp = await fetch(authUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password, returnSecureToken: true })
          });
          data = await resp.json();
        }
        if (data && data.idToken) {
          bru.setVar(tokenVar, data.idToken);
        } else if (data && data.error) {
          console.warn("setup auth failed: " + (data.error.message || JSON.stringify(data.error)));
        }
      } catch (err) {
        console.warn("setup auth: " + (err && err.message ? err.message : err));
      }
    }
  }
  if (tokenVar) {
    bru.setVar("accessToken", bru.getVar(tokenVar) || bru.getEnvVar(tokenVar) || bru.getVar("accessToken") || bru.getEnvVar("accessToken") || "");
  }
  const seedKeys = ["seedGigId","seedVillageId","seedRouteId","seedPamphletId","seedProductId","seedBuyerId","seedMerchantId","seedSupplierId","seedVehicleId","seedCountryId","seedPlanId","seedTariffId","seedSubscriptionId","seedStateId","seedDistrictId"];
  for (const key of seedKeys) {
    const envVal = bru.getEnvVar(key);
    const short = key.replace(/^seed/, "");
    const runtime = short.charAt(0).toLowerCase() + short.slice(1);
    if (envVal && !bru.getVar(runtime)) bru.setVar(runtime, envVal);
    if (envVal && !bru.getVar(key)) bru.setVar(key, envVal);
  }
  const pathBinds = {"planId":"plan_bruno_"};
  for (const key of Object.keys(pathBinds)) {
    bru.setVar(key, pathBinds[key] + bru.getVar("runId"));
  }
}

script:post-response {
  try {
    const method = typeof req.getMethod === "function" ? req.getMethod() : (req.method || "");
    const url = typeof req.getUrl === "function" ? req.getUrl() : (req.url || "");
    const reqBody = typeof req.getBody === "function" ? req.getBody() : req.body;
    console.log("\n------------------------------------------------------------");
    console.log("▶ REQUEST: " + method + " " + url);
    if (reqBody && Object.keys(reqBody).length > 0) {
      console.log("  Request Body:\n" + (typeof reqBody === "object" ? JSON.stringify(reqBody, null, 2) : reqBody));
    }
    const status = typeof res.getStatus === "function" ? res.getStatus() : res.status;
    const resBody = typeof res.getBody === "function" ? res.getBody() : res.body;
    console.log("◀ RESPONSE: " + status);
    if (resBody !== undefined && resBody !== null) {
      console.log("  Response Body:\n" + (typeof resBody === "object" ? JSON.stringify(resBody, null, 2) : resBody));
    }
    console.log("------------------------------------------------------------\n");
  } catch (err) {}
  const status = res.getStatus();
  const body = res.getBody();
  if (status === 200 && body && typeof body === "object") {
    const keys = ["supplierId","userId","gigId","orderId","merchantOrderId","paymentIntentId","intentId","pickupCode","handoverCode","payoutRequestId","payoutTransactionId","beneficiaryId","custodyTransferId","settlementId","discrepancyId","requestId","subscriptionId","authorizationId","certificateId","challanId","taxProfileId","configurationId","countryId","stateId","districtId","villageId","planId","tariffId","offerId","codeId","routeId","refundTransactionId","creditNoteId","exceptionId","periodId"];
    for (const key of keys) {
      if (body[key]) bru.setVar(key, body[key]);
    }
    if (body.paymentIntentId && !body.intentId) bru.setVar("intentId", body.paymentIntentId);
  }
  bru.setVar("teardownCollection", "plans");
  bru.setVar("teardownRecordId", bru.getVar("planId") || bru.getVar("runId"));
}

tests {
  test("status is a spec HTTP code", function () {
    expect([200, 400, 401, 403, 404, 409, 429]).to.include(res.getStatus());
  });
  test("envelope is spec-shaped", function () {
    const status = res.getStatus();
    const body = res.getBody();
    if (status === 200) {
      expect(body).to.be.an("object");

    } else {
      expect(body).to.have.property("error");
      expect(body.error).to.have.property("code");
      expect(body.error).to.have.property("message");
    }
  });
}

docs {
  operationId: upsertSubscriptionPlan
  HTTP: PUT /v1/config/plans/{planId}
  Role: support
  Execute: the spec request. Assert status + error envelope or listed success fields.
  Teardown class: deactivate
}
