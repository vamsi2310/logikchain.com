meta {
  name: Logikchain API
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{correlationId}}
}

script:pre-request {
  if (!bru.getVar("runId")) {
    const runId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
    bru.setVar("runId", runId);
  }
  if (!bru.getVar("correlationId")) {
    bru.setVar("correlationId", `collection:${bru.getVar("runId")}`);
  }
  const overlay = bru.getEnvVar("accessToken");
  if (overlay && !bru.getVar("accessToken")) {
    bru.setVar("accessToken", overlay);
  }
  const appCheck = bru.getVar("appCheckToken") || bru.getEnvVar("appCheckToken");
  if (appCheck && typeof req.setHeader === "function") {
    req.setHeader("X-Firebase-AppCheck", appCheck);
  }
  const appId = bru.getVar("appId") || bru.getEnvVar("appId");
  if (appId && typeof req.setHeader === "function") {
    req.setHeader("X-Firebase-AppId", appId);
  }
  if (!bru.getVar("accessToken")) {
    const authEmulator = bru.getEnvVar("authEmulator");
    const email = bru.getEnvVar("seedSupportEmail") || "vamsi2310@gmail.com";
    const password = bru.getEnvVar("seedPassword") || "TestPassword123!";
    const key = bru.getEnvVar("firebaseWebApiKey") || "fake-api-key";
    if (email && password && typeof bru.sendRequest === "function") {
      try {
        const authUrl = authEmulator
          ? authEmulator + "/identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key
          : "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key;
        const resp = await bru.sendRequest({
          url: authUrl,
          method: "POST",
          headers: { "Content-Type": "application/json" },
          data: { email, password, returnSecureToken: true }
        });
        if (resp && resp.data && resp.data.idToken) {
          bru.setVar("accessToken", resp.data.idToken);
          bru.setVar("supportAccessToken", resp.data.idToken);
        }
      } catch (err) {}
    }
  }
}

docs {
  HTTP `/v1` collection for Logikchain. Law: constitution/Logikchain_API_Testing.md
  Host: emulator by default. Do not point at test or prod.
  Run: npx bru run --env emulator
  Group: npx bru run 03-orders --env emulator
  One API: npx bru run 03-orders/placeOrder --env emulator
}
