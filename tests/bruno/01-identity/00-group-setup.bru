meta {
  name: 01-identity group setup
  type: http
  seq: 0
  tags: [
    identity
  ]
}

get {
  url: {{baseUrl}}/v1/config/catalog?types=countries
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8));
  }
  bru.setVar("correlationId", "01-identity:" + bru.getVar("runId"));
}

docs {
  Group Identity: prepare runId before the operations in this folder.
}
