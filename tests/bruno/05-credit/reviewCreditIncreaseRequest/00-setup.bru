meta {
  name: reviewCreditIncreaseRequest setup
  type: http
  seq: 0
  tags: [
    credit
    reviewCreditIncreaseRequest
    money
  ]
}

get {
  url: {{baseUrl}}/v1/config/catalog?types[]=countries
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlationId}}
}

script:pre-request {
  const operationId = "reviewCreditIncreaseRequest";
  const role = "supplier";
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8));
  }
  bru.setVar("idempotencyKey", "idem-" + operationId + "-" + bru.getVar("runId"));
  bru.setVar("correlationId", operationId + ":" + bru.getVar("runId"));
  const authEmulator = bru.getEnvVar("authEmulator");
  const email = bru.getEnvVar("seedSupplierEmail");
  const password = bru.getEnvVar("seedPassword");
  const tokenVar = "supplierAccessToken";
  if (tokenVar && !bru.getVar(tokenVar)) {
    const existingToken = bru.getEnvVar(tokenVar) || bru.getEnvVar("accessToken");
    if (existingToken) {
      bru.setVar(tokenVar, existingToken);
    } else if (email && password) {
      try {
        const key = bru.getEnvVar("firebaseWebApiKey") || "fake-api-key";
        const authUrl = authEmulator
          ? authEmulator + "/identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key
          : "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key;
        const resp = await fetch(authUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password, returnSecureToken: true })
        });
        const data = await resp.json();
        if (data && data.idToken) {
          bru.setVar(tokenVar, data.idToken);
        } else if (data && data.error) {
          console.warn("setup auth failed: " + data.error.message);
        }
      } catch (err) {
        console.warn("setup auth: " + (err && err.message ? err.message : err));
      }
    }
  }
  if (tokenVar) {
    bru.setVar("accessToken", bru.getVar(tokenVar) || bru.getEnvVar(tokenVar) || bru.getEnvVar("accessToken") || "");
  }
  const seedKeys = ["seedGigId","seedVillageId","seedRouteId","seedPamphletId","seedProductId","seedBuyerId","seedMerchantId","seedSupplierId","seedVehicleId","seedCountryId","seedPlanId","seedTariffId","seedSubscriptionId","seedStateId","seedDistrictId"];
  for (const key of seedKeys) {
    const envVal = bru.getEnvVar(key);
    const short = key.replace(/^seed/, "");
    const runtime = short.charAt(0).toLowerCase() + short.slice(1);
    if (envVal && !bru.getVar(runtime)) bru.setVar(runtime, envVal);
    if (envVal && !bru.getVar(key)) bru.setVar(key, envVal);
  }
  const pathBinds = {};
  for (const key of Object.keys(pathBinds)) {
    bru.setVar(key, pathBinds[key] + bru.getVar("runId"));
  }
}

assert {
  res.status: in [200, 401, 403]
}

docs {
  operationId: reviewCreditIncreaseRequest
  HTTP: PATCH /v1/credit-increase-requests/{requestId}
  Role: supplier
  Setup: mint/refresh the supplier ID token, copy seed fixture vars, mint idempotencyKey and correlationId.
  Does not call reviewCreditIncreaseRequest.
}
