meta {
  name: setProvisionalCreditPolicy teardown
  type: http
  seq: 90
  tags: [
    credit
    setProvisionalCreditPolicy
  ]
}

put {
  url: {{baseUrl}}/v1/credit-profiles/{{merchantId}}/provisional-policy
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Correlation-Id: setProvisionalCreditPolicy-teardown:{{runId}}
}

body:json {
  {
    "merchantId": "{{merchantId}}",
    "enabled": false,
    "cap": 0,
    "reason": "bruno teardown {{runId}}"
  }
}

script:pre-request {
  const operationId = "setProvisionalCreditPolicy";
  const role = "supplier";
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8));
  }
  bru.setVar("idempotencyKey", "idem-" + operationId + "-" + bru.getVar("runId"));
  bru.setVar("correlationId", operationId + ":" + bru.getVar("runId"));
  if (!bru.getVar("supplierPhone")) {
    const randomDigits = Math.floor(100000000 + Math.random() * 900000000).toString();
    bru.setVar("supplierPhone", "+919" + randomDigits);
  }
  const authEmulator = bru.getEnvVar("authEmulator");
  const email = bru.getEnvVar("seedSupplierEmail") || bru.getEnvVar("seedSupportEmail") || "vamsi2310@gmail.com";
  const password = bru.getEnvVar("seedPassword") || "TestPassword123!";
  const tokenVar = "supplierAccessToken";
  if (tokenVar && !bru.getVar(tokenVar)) {
    const existingToken = bru.getVar(tokenVar) || bru.getEnvVar(tokenVar) || bru.getVar("supportAccessToken") || bru.getEnvVar("supportAccessToken") || bru.getVar("accessToken") || bru.getEnvVar("accessToken");
    if (existingToken) {
      bru.setVar(tokenVar, existingToken);
    } else if (email && password) {
      try {
        const key = bru.getEnvVar("firebaseWebApiKey") || "fake-api-key";
        const authUrl = authEmulator
          ? authEmulator + "/identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key
          : "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=" + key;
        let data;
        if (typeof bru.sendRequest === "function") {
          const resp = await bru.sendRequest({
            url: authUrl,
            method: "POST",
            headers: { "Content-Type": "application/json" },
            data: { email, password, returnSecureToken: true }
          });
          data = resp ? resp.data : null;
        } else if (typeof fetch === "function") {
          const resp = await fetch(authUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password, returnSecureToken: true })
          });
          data = await resp.json();
        }
        if (data && data.idToken) {
          bru.setVar(tokenVar, data.idToken);
        } else if (data && data.error) {
          console.warn("setup auth failed: " + (data.error.message || JSON.stringify(data.error)));
        }
      } catch (err) {
        console.warn("setup auth: " + (err && err.message ? err.message : err));
      }
    }
  }
  if (tokenVar) {
    bru.setVar("accessToken", bru.getVar(tokenVar) || bru.getEnvVar(tokenVar) || bru.getVar("accessToken") || bru.getEnvVar("accessToken") || "");
  }
  const seedKeys = ["seedGigId","seedVillageId","seedRouteId","seedPamphletId","seedProductId","seedBuyerId","seedMerchantId","seedSupplierId","seedVehicleId","seedCountryId","seedPlanId","seedTariffId","seedSubscriptionId","seedStateId","seedDistrictId"];
  for (const key of seedKeys) {
    const envVal = bru.getEnvVar(key);
    const short = key.replace(/^seed/, "");
    const runtime = short.charAt(0).toLowerCase() + short.slice(1);
    if (envVal && !bru.getVar(runtime)) bru.setVar(runtime, envVal);
    if (envVal && !bru.getVar(key)) bru.setVar(key, envVal);
  }
  const pathBinds = {};
  for (const key of Object.keys(pathBinds)) {
    bru.setVar(key, pathBinds[key] + bru.getVar("runId"));
  }
}

assert {
  res.status: in [200, 400, 401, 403, 404, 409]
}

docs {
  operationId: setProvisionalCreditPolicy
  Turns off the provisional policy this execute enabled.
}
