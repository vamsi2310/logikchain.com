# ONE alias per file. PWA: copy web/.env.development.example | .env.test.example | .env.production.example
# into the matching gitignored file. Functions: copy functions/.env.example to .env.dev | .env.test | .env.prod.
# Hybrid laptop Functions: web/.env.local.example → web/.env.local (must not set FIREBASE_PROJECT_ALIAS).
# Never one file for all aliases. No runtime picker. Playbooks: constitution/Logikchain_Firebase_Workflow.md.

FIREBASE_PROJECT_ALIAS=dev
FUNCTIONS_REGION=asia-south1

# Firebase Web SDK — values MUST come from the same alias's console (logikchain-dev | -test | -prod)
REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=logikchain-dev.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=logikchain-dev
REACT_APP_FIREBASE_STORAGE_BUCKET=logikchain-dev.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_web_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Firebase Admin SDK — dev (or emulator) only. Never a prod service account on a laptop.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "logikchain-dev", "private_key_id": "...", "private_key": "...", "client_email": "..."}'

# Google Maps — restricted key for THIS alias (server / web / android are three keys)
GOOGLE_MAPS_API_KEY=your_restricted_google_maps_server_key
REACT_APP_GOOGLE_MAPS_API_KEY=your_restricted_web_maps_key
ANDROID_GOOGLE_MAPS_API_KEY=your_restricted_android_maps_key

# Gemini — AI Studio key allowed on emulator/dev only. test/prod use Vertex in the same project.
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key
GCP_VERTEX_PROJECT_ID=logikchain-dev

# Razorpay — test-mode keys on dev/test; live keys only on prod. Webhook secret is per alias.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_secure_custom_webhook_secret_here

# Firebase Cloud Messaging VAPID (web) — per project
REACT_APP_FCM_VAPID_PUBLIC_KEY=your_fcm_vapid_public_key_here

# SMS Gateway & OTP — sandbox on dev/test; production DLT on prod
SMS_GATEWAY_PROVIDER=msg91_or_twilio
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_SENDER_ID=LKGCHN
SMS_GATEWAY_ENTITY_ID=your_trai_dlt_entity_id_here
SMS_GATEWAY_TEMPLATE_ID_OTP=your_trai_dlt_otp_template_id_here
SMS_GATEWAY_TEMPLATE_ID_TRANSACTIONAL=your_trai_dlt_transactional_template_id_here
