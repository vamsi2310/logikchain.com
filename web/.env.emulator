# Local emulator playbook. Safe to commit — no live keys.
# Start: firebase emulators:start && npm run start:emulator (from web/)

FIREBASE_PROJECT_ALIAS=emulator
FUNCTIONS_REGION=asia-south1

REACT_APP_USE_EMULATORS=true
REACT_APP_FIREBASE_API_KEY=demo-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=localhost
REACT_APP_FIREBASE_PROJECT_ID=demo-logikchain
REACT_APP_FIREBASE_STORAGE_BUCKET=demo-logikchain.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=0
REACT_APP_FIREBASE_APP_ID=1:0:web:emulator
REACT_APP_FIREBASE_MEASUREMENT_ID=

REACT_APP_API_BASE_URL=http://127.0.0.1:5001/demo-logikchain/asia-south1/api
REACT_APP_AUTH_EMULATOR_URL=http://127.0.0.1:9099
REACT_APP_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
REACT_APP_STORAGE_EMULATOR_HOST=127.0.0.1:9199
REACT_APP_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
