# Copy to web/.env.test (gitignored). Vite --mode test → alias `test`.
# Fill from Firebase console → logikchain-web-test. No live secrets.

FIREBASE_PROJECT_ALIAS=test
FUNCTIONS_REGION=asia-south1

REACT_APP_FIREBASE_API_KEY=your_test_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=logikchain-test.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=logikchain-test
REACT_APP_FIREBASE_STORAGE_BUCKET=logikchain-test.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_test_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_test_web_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=

REACT_APP_API_BASE_URL=

REACT_APP_GOOGLE_MAPS_API_KEY=your_test_referrer_restricted_maps_key
REACT_APP_FCM_VAPID_PUBLIC_KEY=your_test_vapid_public_key
REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=your_test_recaptcha_enterprise_site_key
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_test_key_id
