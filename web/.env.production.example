# Copy to web/.env.production (gitignored). Vite --mode production → alias `prod`.
# Fill from Firebase console → logikchain-web-prod. No live secrets.
# A production build must not retarget dev, test, or the emulator.

FIREBASE_PROJECT_ALIAS=prod
FUNCTIONS_REGION=asia-south1

REACT_APP_FIREBASE_API_KEY=your_prod_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=logikchain-prod.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=logikchain-prod
REACT_APP_FIREBASE_STORAGE_BUCKET=logikchain-prod.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_prod_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_prod_web_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=

REACT_APP_API_BASE_URL=

REACT_APP_GOOGLE_MAPS_API_KEY=your_prod_referrer_restricted_maps_key
REACT_APP_FCM_VAPID_PUBLIC_KEY=your_prod_vapid_public_key
REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=your_prod_recaptcha_enterprise_site_key
REACT_APP_RAZORPAY_KEY_ID=rzp_live_your_prod_key_id
