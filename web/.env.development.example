# Copy to web/.env.development (gitignored). Vite --mode development → alias `dev`.
# Fill from Firebase console → logikchain-web-dev. No live secrets.

FIREBASE_PROJECT_ALIAS=dev
FUNCTIONS_REGION=asia-south1

REACT_APP_FIREBASE_API_KEY=your_dev_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=logikchain-dev.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=logikchain-dev
REACT_APP_FIREBASE_STORAGE_BUCKET=logikchain-dev.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_dev_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_dev_web_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Empty = same-origin /v1 via Hosting rewrite to `api`.
REACT_APP_API_BASE_URL=

REACT_APP_GOOGLE_MAPS_API_KEY=your_dev_referrer_restricted_maps_key
REACT_APP_FCM_VAPID_PUBLIC_KEY=your_dev_vapid_public_key
REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=your_dev_recaptcha_enterprise_site_key
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_dev_key_id
