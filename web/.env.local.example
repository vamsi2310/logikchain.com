# Copy to web/.env.local (gitignored).
# Points the PWA at Functions running on this machine.
# Auth / Firestore stay on the Vite --mode alias.
#
# From repo root:
#   cd functions && npm run build
#   firebase emulators:start --only functions --project dev
# From web/:
#   npm run start:dev
#
# Do not start the Auth/Firestore emulators in this playbook — Functions would
# write local data while the PWA reads the remote alias.
# Ignored for production builds.

REACT_APP_USE_LOCAL_FUNCTIONS=true
REACT_APP_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
