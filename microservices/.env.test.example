# Logikchain Microservices Environment Configuration
# Target: Test & Staging Environment (logikchain-test)

NODE_ENV=test
GCLOUD_PROJECT=logikchain-test
FIREBASE_PROJECT_ALIAS=test
REGION=asia-south1
FIREBASE_STORAGE_BUCKET=logikchain-test.firebasestorage.app
SYNC_INTERVAL_MS=2000
ENFORCE_APP_CHECK=true

PORT=8080
GATEWAY_URL=https://api-gateway-test-asia-south1.a.run.app

# Microservices Target URLs (Cloud Run internal VPC or service names)
IDENTITY_SERVICE_URL=https://identity-service-test-asia-south1.a.run.app
ORDERS_SERVICE_URL=https://orders-service-test-asia-south1.a.run.app
GIGS_SERVICE_URL=https://gigs-service-test-asia-south1.a.run.app
PAMPHLET_SERVICE_URL=https://pamphlet-service-test-asia-south1.a.run.app
PAYMENTS_SERVICE_URL=https://payments-service-test-asia-south1.a.run.app
PAYOUTS_SERVICE_URL=https://payouts-service-test-asia-south1.a.run.app
CASH_SERVICE_URL=https://cash-service-test-asia-south1.a.run.app
CREDIT_SERVICE_URL=https://credit-service-test-asia-south1.a.run.app
FINANCE_SERVICE_URL=https://finance-service-test-asia-south1.a.run.app
CONFIG_SERVICE_URL=https://config-service-test-asia-south1.a.run.app
GOVERNANCE_SERVICE_URL=https://governance-service-test-asia-south1.a.run.app
SOCIAL_CONNECT_SERVICE_URL=https://social-connect-service-test-asia-south1.a.run.app

# Database URLs via Google Cloud SQL Auth Proxy or VPC Private IP
CONFIG_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/config_db
IDENTITY_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/identity_db
ORDERS_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/orders_db
GIGS_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/gigs_db
PAMPHLET_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/pamphlet_db
PAYMENTS_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/payments_db
PAYOUTS_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/payouts_db
CASH_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/cash_db
CREDIT_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/credit_db
FINANCE_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/finance_db
GOVERNANCE_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/governance_db
SOCIAL_CONNECT_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/social_connect_db
SYNC_DB_URL=postgresql://logikchain_app:CHANGE_ME@10.0.0.3:5432/sync_db

