# syntax=docker/dockerfile:1.4
# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root configurations and common package
COPY packages/common/package.json ./packages/common/
COPY packages/common/tsconfig.json ./packages/common/
COPY packages/common/src ./packages/common/src/

# Build @logikchain/common and register into global npm link registry
WORKDIR /app/packages/common
RUN npm install && npm run build && npm link

# Build target microservice (passed as build arg, e.g. config-service)
ARG SERVICE_NAME=config-service
WORKDIR /app/services/${SERVICE_NAME}
COPY services/${SERVICE_NAME}/package.json ./
COPY services/${SERVICE_NAME}/tsconfig.json ./
COPY services/${SERVICE_NAME}/src ./src/

# Link local common first so npm doesn't query public registry, then install and build
RUN npm link @logikchain/common && npm install && npm run build

# Stage 2: Production Runtime
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Security: Non-root user
USER node

ARG SERVICE_NAME=config-service
WORKDIR /app/packages/common
COPY --chown=node:node --from=builder /app/packages/common/dist ./dist
COPY --chown=node:node --from=builder /app/packages/common/package.json ./package.json
COPY --chown=node:node --from=builder /app/packages/common/node_modules ./node_modules

WORKDIR /app/services/${SERVICE_NAME}
COPY --chown=node:node --from=builder /app/services/${SERVICE_NAME}/package.json ./
COPY --chown=node:node --from=builder /app/services/${SERVICE_NAME}/dist ./dist
COPY --chown=node:node --from=builder /app/services/${SERVICE_NAME}/node_modules ./node_modules

EXPOSE 4000-4020

CMD ["node", "dist/index.js"]
