# syntax=docker/dockerfile:1.4
FROM node:22-alpine AS builder

WORKDIR /app

# Build common library
COPY packages/common/package.json ./packages/common/
COPY packages/common/tsconfig.json ./packages/common/
COPY packages/common/src ./packages/common/src/

WORKDIR /app/packages/common
RUN npm install && npm run build && npm link

# Build firebase-bridge
WORKDIR /app/services/firebase-bridge
COPY services/firebase-bridge/package.json ./
COPY services/firebase-bridge/tsconfig.json ./
COPY services/firebase-bridge/src ./src/

RUN npm link @logikchain/common && npm install && npm run build

# Production Runner
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

WORKDIR /app/packages/common
COPY --chown=node:node --from=builder /app/packages/common/dist ./dist
COPY --chown=node:node --from=builder /app/packages/common/package.json ./package.json
COPY --chown=node:node --from=builder /app/packages/common/node_modules ./node_modules

WORKDIR /app/services/firebase-bridge
COPY --chown=node:node --from=builder /app/services/firebase-bridge/package.json ./
COPY --chown=node:node --from=builder /app/services/firebase-bridge/dist ./dist
COPY --chown=node:node --from=builder /app/services/firebase-bridge/node_modules ./node_modules

USER node
EXPOSE 4050

CMD ["node", "dist/index.js"]
