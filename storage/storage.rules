rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isSupport() {
      return hasRole('support');
    }

    function isSupplier() {
      return hasRole('supplier');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isDocument() {
      return isImage() || request.resource.contentType == 'application/pdf';
    }

    // 1. User profile pictures (Avatars)
    // Public read so avatars can be shown on receipts, orders, and UI.
    // Writes restricted to profile owner or Support.
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(userId) || isSupport())
        && request.resource.size < 5 * 1024 * 1024
        && isImage();
    }

    // 2. Product inventory pictures & catalog images
    // Public read so buyers, merchants, and visitors can browse products and pamphlets.
    // Writes restricted to the owning supplier or Support.
    match /products/{supplierId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(supplierId) || (isSupplier() && request.auth.uid == supplierId) || isSupport())
        && request.resource.size < 10 * 1024 * 1024
        && isImage();
    }

    // 3. Proof photos (Delivery, handover, pickup evidence)
    // Read restricted to authenticated parties (owner, driver, supplier, support).
    // Writes restricted to the user capturing proof.
    match /proofs/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        hasRole('support') ||
        hasRole('supplier') ||
        hasRole('vehicle')
      );
      allow write: if isOwner(userId)
        && request.resource.size < 8 * 1024 * 1024
        && isImage();
    }

    // 4. KYC & Business verification documents (PAN, GSTIN, RC, licenses, tax)
    // Private: accessible only by the account owner and Support.
    match /documents/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSupport();
      allow write: if (isOwner(userId) || isSupport())
        && request.resource.size < 15 * 1024 * 1024
        && isDocument();
    }

    // 5. Data export requests and reports
    // Read by the user who requested it or Support.
    // Writes generated exclusively by Firebase Functions (Admin SDK).
    match /exports/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSupport();
      allow write: if false;
    }

    // 6. Provider payloads, challans, close packs, accounting statements — Functions only.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
